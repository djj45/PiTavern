{
  "name": "pitavern",
  "private": true,
  "version": "0.1.0",
  "description": "PiTavern — 基于 pi 运行时的 agent 化酒馆",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bash ./start.command",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present && tsc -p tsconfig.browser.json",
    "e2e": "npm run e2e -w apps/server",
    "verify:bridge": "npm run verify:bridge -w apps/server",
    "verify:tools": "npm run verify:tools -w apps/server",
    "verify:m4": "npm run verify:m4 -w apps/server",
    "verify:takeover": "npm run verify:takeover -w apps/server",
    "verify:m6": "npm run verify:m6 -w apps/server",
    "verify:regression": "npm run verify:regression -w apps/server",
    "verify:compat": "npm run verify:compat -w apps/server",
    "verify:chat-ux": "npm run verify:chat-ux -w apps/server",
    "verify:rendering": "npm run verify:rendering -w apps/web",
    "verify:activity": "npm run verify:activity -w apps/server",
    "verify:world-display": "npm run verify:world-display -w apps/server",
    "verify:library": "npm run verify:library -w apps/server",
    "verify:ci": "node scripts/verify-ci.mjs",
    "verify:browser": "playwright test",
    "verify:regex-isolation": "npm run verify:regex-isolation -w apps/server",
    "verify:library-maintenance": "npm run verify:library-maintenance -w apps/server"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
