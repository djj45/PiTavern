{
  "format": "pitavern-world-template",
  "version": 1,
  "name": "雾港最后一盏灯",
  "description": "单人港城调查：修灯、引航、核验证据。v4 日程；无硬性截止时间。",
  "template": {
    "schemaVersion": 4,
    "templateId": "fogharbor-last-light",
    "templateVersion": 1,
    "rulesVersion": 1,
    "locations": [
      {
        "id": "hall",
        "name": "潮声公所",
        "description": "夜间议事厅，墙上挂着港图与告示栏。各条街道在这里会合。"
      },
      {
        "id": "workshop",
        "name": "铜鸥工坊",
        "description": "乔砚经营的维修铺，窗台上排列着玻璃与铜环。"
      },
      {
        "id": "lighthouse",
        "name": "北灯塔",
        "description": "沿堤岸可达的灯塔，石阶潮湿；这里可以检查灯座。"
      },
      {
        "id": "pier",
        "name": "旧栈桥",
        "description": "引水员等船的木栈桥，系船柱旁有一口值夜钟。"
      },
      {
        "id": "archive",
        "name": "潮汐档案室",
        "description": "公所对外开放的旧档案室，值班簿按日期装订。"
      }
    ],
    "actors": [
      {
        "id": "player",
        "name": "外港调查员",
        "description": "受托来到雾港的调查员；姓名和背景由玩家决定。"
      },
      {
        "id": "lin",
        "name": "林照",
        "description": "港务书记。说话谨慎，习惯将亲眼所见与推测分开。"
      },
      {
        "id": "qiao",
        "name": "乔砚",
        "description": "工坊匠人。言辞直接，先看工具和材料，再谈传闻。"
      },
      {
        "id": "yan",
        "name": "燕迟",
        "description": "年轻引水员。紧张时会搓绳结，熟悉港湾航线。"
      }
    ],
    "items": [
      {
        "id": "warrant",
        "name": "调查委托书",
        "price": 0,
        "description": "公所出具的调查凭据。"
      },
      {
        "id": "lens",
        "name": "聚光片",
        "price": 18,
        "description": "与北灯灯座规格相符的备件。"
      },
      {
        "id": "repair_receipt",
        "name": "维修交接单",
        "price": 0,
        "description": "维修任务完成的纸质回执，交互时出示。"
      },
      {
        "id": "rescue_receipt",
        "name": "救援登记副本",
        "price": 0,
        "description": "船只引导任务完成后的登记凭据。"
      }
    ],
